total_ms": 665.7731999998759, "queue_wait_ms": 0.0, "start_ms": 1177.4, "cancelled": false}], "events": [{"at_ms": 0.0, "name": "client", "patience_s": 120.0}, {"at_ms": 0.1, "name": "papers_named", "papers": ["moshi"]}, {"at_ms": 1845.8, "name": "verified", "round": 0, "refused": false, "kept": 4, "dropped": []}], "status": "ok", "outcome": "answered", "first_token_ms": 1845.8725000000413, "total_ms": 1845.8855000003496, "retries": 0, "regenerations": 0, "tokens_in": 957, "tokens_out": 212, "degraded": false, "queue_wait_ms": 0.039399999877787195, "queue_len_at_arrival": 0, "answer": "Inner Monologue is a training and inference setup for Moshi that decomposes speech into a hierarchical sequence of text, semantic, and acoustic tokens and predicts this structured sequence step\u2011by\u2011step, with each prediction step outputting a speech frame. [1][2] It is used because it allows Moshi to represent all utterances simultaneously as text and speech, rather than switching between modalities, and because integrating acoustic tokens into the same generative model enables generating arbitrary voices and conditions instead of a single speaker. [1] The hierarchical modeling also lets Moshi decompose the generation task without increasing the Transformer sequence length, and the per\u2011frame prediction makes Moshi compatible with real\u2011time generation. [1] Finally, by predicting time\u2011aligned text tokens before audio tokens and delaying between token types, Inner Monologue enables deriving streaming TTS and ASR systems from a single Moshi model. [2]", "citations": ["[1] Moshi (arXiv 2410.00037v1), \u00a72 Related Work, p.5", "[2] Moshi (arXiv 2410.00037v1), \u00a71 Introduction, p.3"], "answer_grade": ""}
